# ---- Dependencies ----
node_modules/

# ---- Build output ----
dist/
src-tauri/target/

# ---- Tauri generated ----
src-tauri/gen/schemas/
src-tauri/gen/android/**/build/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/.tauri/
src-tauri/gen/android/local.properties

# ---- Tauri Android plugin build output ----
src-tauri/plugins/*/android/build/
src-tauri/plugins/*/android/.gradle/
src-tauri/plugins/*/android/.tauri/
src-tauri/plugins/*/android/local.properties

# ---- Local runtime / user data (never commit) ----
data/
backup/
_diag/

