TimeManage.exe
*.exe
*.apk
*.aab
*.msi
*.dmg
*.AppImage
*.deb

# ---- Signing material (never commit) ----
*.jks
*.keystore
*.p12
*.pfx
key.properties
keystore.properties

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.swp

# ---- Logs ----
*.log
